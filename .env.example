# Copy to .env (git-ignored) for local use: cp .env.example .env
# In deployment, inject these as real environment variables instead; never commit .env.
# These values are throwaway local-dev defaults.

# docker-compose services
POSTGRES_USER=gold2psql
POSTGRES_PASSWORD=gold2psql
POSTGRES_DB=serving
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# gold2psql (must match the values above for the local containers)
GOLD2PSQL_DSN=postgresql://gold2psql:gold2psql@localhost:5433/serving
GOLD2PSQL_AMQP_URL=amqp://guest:guest@localhost:5672/
# GOLD2PSQL_ENV=prod   # disables masking; leave unset outside production
